# ============================================================
# Pi Agent Docker 环境变量示例
# 复制为同目录的 .env 后按需修改（docker compose 会自动读取 .env）
# ============================================================

# 容器内部端口已在镜像内固定（Dockerfile ENV）：pi-web = 30141，code-server = 8443，
# 无需在此配置；docker-compose.yml 的 ports 即 宿主:容器 映射（默认宿主=容器）。

# 可选：Web UI Basic Auth 密码（用户名默认为 pi）。留空则无密码。
# PI_WEB_PASSWORD=your_secure_password

# 可选：code-server 登录密码。留空则每次启动随机生成并打印到容器日志。
# CODE_SERVER_PASSWORD=your_secure_password
# 注意：密码里若含 $ ! * 等特殊字符，compose 会做变量插值把 $VAR 当环境变量
#       处理（可能吞掉一段），且 supervisord 的 environment 值需加引号才能解析。
#       建议用纯字母数字密码；若一定要特殊字符，env 里 $ 写成 $$ 并在镜像内处理。
#       另外 CODE_SERVER_PASSWORD 必须通过 ${...} 从本文件引用，不要写成字面量。

# 可选：容器启动时自动安装的 VS Code 扩展 ID（逗号分隔）
# CODE_SERVER_EXTENSIONS=ms-ceintl.vscode-language-pack-zh-hans,esbenp.prettier-vscode

# 可选：是否随容器启动 code-server（true/false）。false 时只跑 pi-web。
# CODE_SERVER_ENABLED=true

# 自动更新 pi agent 与 pi-web 到 npm 最新版（true/false）
AUTO_UPDATE=false

# HTTP 代理（仅用于 pi-web 服务端访问模型/API 请求，可选）
# 若代理运行在 Docker 宿主机上，用 host.docker.internal 而非 127.0.0.1
# HTTP_PROXY=http://host.docker.internal:7890
# HTTPS_PROXY=http://host.docker.internal:7890
# NO_PROXY=localhost,127.0.0.1

# LLM Provider API Keys（按需填写）
# ANTHROPIC_API_KEY=sk-ant-xxx
# OPENAI_API_KEY=sk-xxx
# DEEPSEEK_API_KEY=sk-xxx
# GEMINI_API_KEY=AIzaSyxxx
