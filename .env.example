# ============================================================
# Pi Agent Docker 环境变量配置示例
# 复制本文件为 .env 后按需配置（docker compose 会自动加载 .env）
# ============================================================

# [可选] Pi Web UI 访问密码（留空则免密，用户名默认为 pi）
# PI_WEB_PASSWORD=your_secure_password

# [可选] Code-server (VS Code Web) 登录密码
# 留空时容器每次启动会自动生成随机密码并打印在容器日志中
# CODE_SERVER_PASSWORD=your_secure_password

# [可选] 容器启动时自动安装的 VS Code 扩展 ID（多个用英文逗号分隔）
# CODE_SERVER_EXTENSIONS=ms-ceintl.vscode-language-pack-zh-hans,esbenp.prettier-vscode

# [可选] 是否启用 Code-server（true/false，默认 true）
# CODE_SERVER_ENABLED=true

# [可选] 容器启动时自动将 pi agent 与 pi-web 更新至 npm 最新版（true/false）
AUTO_UPDATE=false

# [可选] HTTP 代理设置（用于访问模型 API）
# 若代理运行在宿主机上，请使用 host.docker.internal
# HTTP_PROXY=http://host.docker.internal:7890
# HTTPS_PROXY=http://host.docker.internal:7890
# NO_PROXY=localhost,127.0.0.1

# [必填/选填] LLM Provider API Keys（至少配置一种可用模型）
# ANTHROPIC_API_KEY=sk-ant-xxx
# OPENAI_API_KEY=sk-xxx
# DEEPSEEK_API_KEY=sk-xxx
# GEMINI_API_KEY=AIzaSyxxx
