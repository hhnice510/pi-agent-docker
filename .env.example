# Pi Web UI Port (Default: 30141)
PORT=30141

# Optional Web UI Basic Auth Password (Username defaults to 'pi')
# PI_WEB_PASSWORD=your_secure_password

# Auto update pi agent and pi-web packages on container startup (true/false)
AUTO_UPDATE=false

# HTTP Proxy for pi-web server-side model/API requests (optional)
# If your proxy runs on the Docker HOST machine, use host.docker.internal
# instead of 127.0.0.1 (127.0.0.1 inside the container points to the container itself).
# HTTP_PROXY=http://host.docker.internal:7890
# HTTPS_PROXY=http://host.docker.internal:7890
# NO_PROXY=localhost,127.0.0.1

# LLM Provider API Keys (Configure the ones you use)
# ANTHROPIC_API_KEY=sk-ant-xxx
# OPENAI_API_KEY=sk-xxx
# DEEPSEEK_API_KEY=sk-xxx
# GEMINI_API_KEY=AIzaSyxxx
